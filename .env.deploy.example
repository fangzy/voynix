# Voynix FC 部署凭据示例(部署专用,不入库)
# 复制为 .env.deploy 并填入真实值:
#   cp .env.deploy.example .env.deploy
#
# 本文件只存部署凭据;Xray 运行时变量(UUID/GRPC_SERVICE_NAME)仍在 docker-image/.env
# 由 scripts/deploy-fc.sh 与 GitHub Actions 部署时读取

# ===== Docker Hub(香港节点镜像源,仓库需为 Public) =====
DOCKERHUB_USERNAME=your-dockerhub-username
DOCKERHUB_TOKEN=your-dockerhub-access-token

# ===== 阿里云(Serverless Devs 部署 FC 用) =====
ALIBABA_CLOUD_ACCOUNT_ID=your-alibaba-account-id
ALIBABA_CLOUD_ACCESS_KEY_ID=your-access-key-id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your-access-key-secret

# ===== 部署范围(可选,与 CI 的 FC_NODES 变量语义一致) =====
# 逗号分隔节点键,deploy-fc.sh 与 gen-client-config.sh 均读取本文件;
# 留空/注释掉 → deploy-fc.sh 部署全部节点 / gen-client-config.sh 生成全部节点
# FC_NODES=sg,hk,tokyo

# ===== 镜像/函数名前缀(可选,默认 voynix-xray) =====
# Docker Hub 镜像名与 FC 函数名前缀(如 voynix-xray-sg);公开 fork 后建议改成自己的名字;
# 需与 GitHub Actions 的 IMAGE_NAME Secret 保持一致
# IMAGE_NAME=voynix-xray

