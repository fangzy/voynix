# Voynix 统一环境变量模板 — 复制为 .env 并填写(.env gitignored,不入库)
#   cp .env.example .env
#
# 单文件按注释分三节:common(两端共享)/ deploy(部署凭据+参数)/ client(客户端生成参数)
# deploy-fc.sh / gen-client-config.sh / docker-compose.yml 均从根目录 .env 读取

# ===== common(部署+客户端共享的协议配置,须两端一致) =====
UUID=your-uuid-here
# 32-128 字符,Base64 字符集(openssl rand -base64 48)
FC_BEARER_TOKEN=your-bearer-token-here
# WS path
WS_PATH=ws

# ===== deploy(部署凭据+参数,镜像到 GitHub Secrets 供 CI) =====
DOCKERHUB_USERNAME=your-dockerhub-username
DOCKERHUB_TOKEN=your-dockerhub-token
ALIBABA_CLOUD_ACCOUNT_ID=your-account-id
ALIBABA_CLOUD_ACCESS_KEY_ID=your-access-key-id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your-access-key-secret
# 部署/生成范围(逗号分隔节点键;留空=全部节点)
FC_NODES=sg,hk,tokyo
IMAGE_NAME=voynix-xray
# 中转模式(可选):设 RELAY_EXIT_HOST 后 s.yaml 中 shanghai 以中转入口部署(outbound 链到出口节点)
# RELAY_EXIT_HOST=出口节点 fcapp.run 域名(aliyun fc GetTrigger 获取);PORT/TLS 默认 443/true,本地联调 8089/false
#RELAY_EXIT_HOST=
RELAY_EXIT_PORT=443
RELAY_EXIT_TLS=true

# ===== client(客户端配置生成参数) =====
# 场景组:分号分隔场景、逗号分隔节点 key;**值必须加引号**(source 时未加引号的分号会被 shell 当命令分隔符,后段场景丢失);注释掉=不生成场景组(仅全量 Auto/LB)
SCENE_NODES="company=sg,tokyo;home=hk,tokyo"
# 中继路由(可选):name=入口>出口,分号分隔多条;生成中继节点(客户端只连入口,转发链在服务端完成;入口须以中转模式部署)
RELAY_ROUTES="sh-tokyo=shanghai>tokyo"
