mixed-port: 7890
allow-lan: false
mode: rule
log-level: warning
external-controller: 127.0.0.1:9090
keep-alive-interval: 30
tcp-concurrent: true
tcp-fast-open: true
unified-delay: true
find-process-mode: always
geodata-mode: true
profile:
  store-selected: true
  store-fake-ip: true

dns:
  enable: true
  listen: 0.0.0.0:1053
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter:
    - '*.lan'
    - localhost.ptlogin2.qq.com
  nameserver:
    - 223.5.5.5
    - https://doh.pub/dns-query
    - https://dns.alidns.com/dns-query
  proxy-server-nameserver:
    - 223.5.5.5
    - 119.29.29.29
  respect-rules: true

# fake-ip 模式下嗅探真实域名,保证 GEOIP/规则命中准确(DIRECT 直连判断不再依赖 fake-ip)
sniffer:
  enable: true
  force-dns-mapping: true
  parse-pure-ip: true
  sniff:
    HTTP:
      ports: [80, 8080-8880]
      override-destination: true
    TLS:
      ports: [443, 8443]
    QUIC:
      ports: [443]

proxies:
# BEGIN_PROXIES
# END_PROXIES

# BEGIN_GROUPS
# END_GROUPS

# ---- 成熟规则集:Loyalsoldier/clash-rules(全量 13 个,每日 6:30 自动构建;jsdelivr CDN 更新延迟约 12h)----
# 本地缓存于 ./ruleset/;rules 中按序引用,命中即停,无需手维护域名列表
rule-providers:
  reject:
    type: http
    behavior: domain
    url: "https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/reject.txt"
    path: ./ruleset/reject.yaml
    interval: 86400

  icloud:
    type: http
    behavior: domain
    url: "https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/icloud.txt"
    path: ./ruleset/icloud.yaml
    interval: 86400

  apple:
    type: http
    behavior: domain
    url: "https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/apple.txt"
    path: ./ruleset/apple.yaml
    interval: 86400

  google:
    type: http
    behavior: domain
    url: "https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/google.txt"
    path: ./ruleset/google.yaml
    interval: 86400

  proxy:
    type: http
    behavior: domain
    url: "https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/proxy.txt"
    path: ./ruleset/proxy.yaml
    interval: 86400

  direct:
    type: http
    behavior: domain
    url: "https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/direct.txt"
    path: ./ruleset/direct.yaml
    interval: 86400

  private:
    type: http
    behavior: domain
    url: "https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/private.txt"
    path: ./ruleset/private.yaml
    interval: 86400

  gfw:
    type: http
    behavior: domain
    url: "https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/gfw.txt"
    path: ./ruleset/gfw.yaml
    interval: 86400

  tld-not-cn:
    type: http
    behavior: domain
    url: "https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/tld-not-cn.txt"
    path: ./ruleset/tld-not-cn.yaml
    interval: 86400

  telegramcidr:
    type: http
    behavior: ipcidr
    url: "https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/telegramcidr.txt"
    path: ./ruleset/telegramcidr.yaml
    interval: 86400

  cncidr:
    type: http
    behavior: ipcidr
    url: "https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/cncidr.txt"
    path: ./ruleset/cncidr.yaml
    interval: 86400

  lancidr:
    type: http
    behavior: ipcidr
    url: "https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/lancidr.txt"
    path: ./ruleset/lancidr.yaml
    interval: 86400

  applications:
    type: http
    behavior: classical
    url: "https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/applications.txt"
    path: ./ruleset/applications.yaml
    interval: 86400

  # Voynix 自定义覆盖层(2026-09-03;规则文件为 payload: YAML 格式,与 Loyalsoldier 同构;不含策略名,策略在 rules 装配行绑定;jsdelivr 拉取,behavior domain,format 默认 yaml——⚠️ 文件勿改纯文本逐行,否则解析成 0 条规则)
  custom-reject:
    type: http
    behavior: domain
    url: "https://cdn.jsdelivr.net/gh/fangzy/voynix@main/client-config/custom-reject.txt"
    path: ./ruleset/custom-reject.yaml
    interval: 86400

  custom-direct:
    type: http
    behavior: domain
    url: "https://cdn.jsdelivr.net/gh/fangzy/voynix@main/client-config/custom-direct.txt"
    path: ./ruleset/custom-direct.yaml
    interval: 86400

  custom-download:
    type: http
    behavior: domain
    url: "https://cdn.jsdelivr.net/gh/fangzy/voynix@main/client-config/custom-download.txt"
    path: ./ruleset/custom-download.yaml
    interval: 86400

  custom-proxy:
    type: http
    behavior: domain
    url: "https://cdn.jsdelivr.net/gh/fangzy/voynix@main/client-config/custom-proxy.txt"
    path: ./ruleset/custom-proxy.yaml
    interval: 86400

rules:
  # ---- 自定义覆盖层装配(2026-09-03;规则=纯域名列表(rule-providers custom-*),策略在此绑定)----
  # 顺序契约:AND-REJECT > reject(遥测)> proxy(窄代理特例,如 developer.apple.com,须先于 direct 内 apple.com 宽直连)
  # > direct(直连覆盖:google 子域窄规则 + apple.com 宽直连)> download > GEOSITE cn(须在 tld-not-cn 前)
  # ⚠️ 若日后向 custom-proxy 添加宽域(如 google.com),须确认 custom-direct 内其子域不被吞(保持窄先于宽)
  - AND,((NETWORK,udp),(DST-PORT,443)),REJECT
  - RULE-SET,custom-reject,REJECT
  - RULE-SET,custom-proxy,Proxy
  - RULE-SET,custom-direct,DIRECT
  - RULE-SET,custom-download,Proxy-Download
  - GEOSITE,cn,DIRECT
  # ---- 成熟规则集 Loyalsoldier/clash-rules 全量 13 个(每日自动更新,定义见 rule-providers)----
  # applications 为 PROCESS-NAME 规则,需 find-process-mode: always 才生效(strict/on 不匹配 provider 内进程规则,2026-08-31 已开 always)
  - RULE-SET,applications,DIRECT
  - RULE-SET,private,DIRECT
  - RULE-SET,reject,REJECT
  - RULE-SET,icloud,DIRECT
  - RULE-SET,apple,DIRECT
  - RULE-SET,google,Proxy
  - RULE-SET,proxy,Proxy
  - RULE-SET,direct,DIRECT
  - RULE-SET,gfw,Proxy
  - RULE-SET,tld-not-cn,Proxy
  - RULE-SET,telegramcidr,Proxy
  - RULE-SET,lancidr,DIRECT
  - RULE-SET,cncidr,DIRECT
  - GEOIP,CN,DIRECT
  - MATCH,DIRECT
