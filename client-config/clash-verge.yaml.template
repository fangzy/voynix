mixed-port: 7890
allow-lan: false
mode: rule
log-level: warning
external-controller: 127.0.0.1:9090
keep-alive-interval: 30
tcp-concurrent: true
tcp-fast-open: true
unified-delay: true
find-process-mode: off
geodata-mode: true
profile:
  store-selected: true
  store-fake-ip: true

dns:
  enable: true
  listen: 0.0.0.0:1053
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter:
    - '*.lan'
    - localhost.ptlogin2.qq.com
  nameserver:
    - 223.5.5.5
    - https://doh.pub/dns-query
    - https://dns.alidns.com/dns-query
  proxy-server-nameserver:
    - 223.5.5.5
    - 119.29.29.29
  respect-rules: true

# fake-ip 模式下嗅探真实域名,保证 GEOIP/规则命中准确(DIRECT 直连判断不再依赖 fake-ip)
sniffer:
  enable: true
  force-dns-mapping: true
  parse-pure-ip: true
  sniff:
    HTTP:
      ports: [80, 8080-8880]
      override-destination: true
    TLS:
      ports: [443, 8443]
    QUIC:
      ports: [443]

proxies:
# BEGIN_PROXIES
# END_PROXIES

# BEGIN_GROUPS
# END_GROUPS

rules:
  - AND,((NETWORK,udp),(DST-PORT,443)),REJECT
  # ---- 国外遥测/埋点 REJECT(2026-08-30 本机 mihomo 日志分析;省 proxy 流量)----
  # 国内遥测域名走 GEOSITE,cn,DIRECT,不消耗 proxy,不在此列
  - DOMAIN,mobile.events.data.microsoft.com,REJECT
  - DOMAIN,default.exp-tas.com,REJECT
  - DOMAIN,analytics.google.com,REJECT
  - DOMAIN-SUFFIX,googletagmanager.com,REJECT
  - DOMAIN-SUFFIX,doubleclick.net,REJECT
  - DOMAIN-SUFFIX,scorecardresearch.com,REJECT
  - DOMAIN-SUFFIX,sentry.io,REJECT
  # ---- MSN/Bing 直连(微软中国服务,不走 proxy)----
  - DOMAIN-SUFFIX,msn.com,DIRECT
  - DOMAIN-SUFFIX,msn.com.cn,DIRECT
  - DOMAIN-SUFFIX,msn.cn,DIRECT
  - DOMAIN-SUFFIX,bing.com,DIRECT
  - DOMAIN-SUFFIX,bing.com.cn,DIRECT
  # ---- 系统打点/遥测/推送直连,不走 proxy(降低成本)----
  - DOMAIN,wpad,DIRECT
  - DOMAIN-SUFFIX,msftconnecttest.com,DIRECT
  - DOMAIN-SUFFIX,msftncsi.com,DIRECT
  - DOMAIN-SUFFIX,smartscreen.microsoft.com,DIRECT
  - DOMAIN-SUFFIX,events.data.microsoft.com,DIRECT
  - DOMAIN-SUFFIX,wns.windows.com,DIRECT
  - DOMAIN-SUFFIX,delivery.mp.microsoft.com,DIRECT
  - DOMAIN-SUFFIX,windowsupdate.com,DIRECT
  - DOMAIN-SUFFIX,update.microsoft.com,DIRECT
  - DOMAIN-SUFFIX,gateway.icloud.com,DIRECT
  # ---- Apple 服务默认直连(apple.com 全后缀;个别需走代理的例外在其前单独加 Proxy 规则)----
  - DOMAIN-SUFFIX,developer.apple.com,Proxy
  - DOMAIN-SUFFIX,apple.com,DIRECT
  - DOMAIN-SUFFIX,digicert.com,DIRECT
  - DOMAIN-SUFFIX,geotrust.com,DIRECT
  - DOMAIN-SUFFIX,comodoca.com,DIRECT
  - DOMAIN-SUFFIX,globalsign.com,DIRECT
  # ---- Edge/VS Code 更新与 CDN 直连(功能域名,不走 proxy)----
  - DOMAIN-SUFFIX,edge.microsoft.com,DIRECT
  - DOMAIN-SUFFIX,vscode-cdn.net,DIRECT
  - DOMAIN-SUFFIX,youtube.com,Streaming
  - DOMAIN-SUFFIX,googlevideo.com,Streaming
  - DOMAIN-SUFFIX,netflix.com,Streaming
  - DOMAIN-SUFFIX,google.com,Proxy
  - DOMAIN-SUFFIX,github.com,Proxy
  - DOMAIN-SUFFIX,b.ai,Proxy
  # ---- 国内域名直连(GEOSITE 按域名判断,解决海外 CDN IP 漏判)----
  - GEOSITE,cn,DIRECT
  # ---- 海外域名走代理(geolocation-!cn 非中国域名)----
  - GEOSITE,geolocation-!cn,Proxy
  - GEOIP,CN,DIRECT
  - MATCH,DIRECT
