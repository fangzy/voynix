{
  "log": {
    "loglevel": "none"
  },
  "inbounds": [
    {
      "port": 8089,
      "listen": "0.0.0.0",
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "${UUID}"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "ws",
        "wsSettings": {
          "path": "/${WS_PATH}"
        },
        "sockopt": {
          "tcpFastOpen": ${TFO},
          "tcpNoDelay": true,
          "tcpKeepAliveIdle": 30,
          "tcpKeepAliveInterval": 30
        }
      }
    }
  ],
  "outbounds": [
    {
      "tag": "relay-exit",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "${RELAY_EXIT_HOST}",
            "port": ${RELAY_EXIT_PORT},
            "users": [
              {
                "id": "${UUID}",
                "encryption": "none",
                "level": 0
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "ws",
        "security": "${RELAY_EXIT_SECURITY}",
        "tlsSettings": {
          "serverName": "${RELAY_EXIT_HOST}"
        },
        "wsSettings": {
          "path": "/${WS_PATH}",
          "headers": {
            "Host": "${RELAY_EXIT_HOST}",
            "Authorization": "Bearer ${FC_BEARER_TOKEN}"
          }
        }
      }
    },
    {
      "tag": "direct",
      "protocol": "freedom",
      "settings": {}
    },
    {
      "tag": "blocked",
      "protocol": "blackhole",
      "settings": {}
    }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "type": "field",
        "ip": ["geoip:private"],
        "outboundTag": "blocked"
      }
    ]
  }
}
